# Copia este archivo a .env y NO lo commitees (.env esta en .gitignore).
# Los valores los escribe solo scripts/fb-token.mjs — no pegues secretos en el chat.

# Pagina de Facebook "El Diario de los casi"
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Instagram Business vinculado (@eldiariodeloscasi)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Version de la Graph API
GRAPH_VERSION=v21.0

# OpenRouter (generacion de fondos con FLUX). Crear en https://openrouter.ai/keys
# y cargarle saldo. Debe empezar con sk-or-.
OPENROUTER_API_KEY=
