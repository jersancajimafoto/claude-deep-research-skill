<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Cobertura Entrega de Lotes Etapa I — Loma Alta · Jers | IA</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#EFEAE0; --terra:#C97B58; --terra-deep:#B8654A; --ink:#1C1712;
    --dark:#141210; --blush:#E7D6CB; --sand:#E3DACC; --muted:#5c5249; --line:#ddd2c1;
    --serif:'Fraunces',Georgia,serif; --sans:'Inter',system-ui,sans-serif; --mono:'JetBrains Mono',monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:var(--sans);color:var(--ink);background:#cfc8ba}
  @page{size:A4;margin:0}
  .page{width:210mm;height:297mm;background:var(--cream);position:relative;overflow:hidden;
    padding:18mm 18mm 22mm;margin:0 auto 12px;
    background-image:radial-gradient(rgba(28,23,18,.02) 1px,transparent 1px);background-size:4px 4px}
  @media print{.page{margin:0;box-shadow:none;page-break-after:always}}

  .kick{font-family:var(--mono);font-size:9.5pt;letter-spacing:.16em;text-transform:uppercase;color:var(--terra);font-weight:700}
  .brand{position:absolute;bottom:12mm;left:18mm;right:18mm;display:flex;justify-content:space-between;
    font-family:var(--mono);font-size:8pt;letter-spacing:.1em;text-transform:uppercase;color:#8a7d70;
    border-top:1px solid var(--sand);padding-top:3.5mm}
  h1{font-family:var(--serif);font-weight:600;line-height:1.02;letter-spacing:-.01em}
  h2{font-family:var(--serif);font-weight:600;font-size:20pt;line-height:1.08;margin-bottom:4mm}
  h2 em{font-style:italic;color:var(--terra)}
  h3{font-family:var(--serif);font-weight:600;font-size:13pt;line-height:1.15}
  p{font-size:10.5pt;line-height:1.55;color:#3a332c;margin-bottom:3mm}
  p b{color:var(--ink)}
  .lead{font-size:11pt}

  /* ---------- cover ---------- */
  .cover{display:flex;flex-direction:column;justify-content:center}
  .cover h1{font-size:36pt}.cover h1 em{font-style:italic;color:var(--terra)}
  .cover .sub{font-family:var(--serif);font-style:italic;font-size:14.5pt;color:var(--muted);margin-top:6mm;max-width:150mm;line-height:1.35}
  .badge{display:inline-block;background:var(--blush);color:#7a4a34;font-family:var(--mono);font-weight:700;
    font-size:8.5pt;letter-spacing:.12em;text-transform:uppercase;padding:3mm 5mm;border-radius:3mm;margin-bottom:9mm;align-self:flex-start}
  .facts{display:flex;gap:0;margin-top:12mm;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .facts div{flex:1;padding:5mm 0;border-right:1px solid var(--line)}
  .facts div:last-child{border-right:none}
  .facts .n{font-family:var(--serif);font-weight:700;font-size:17pt;color:var(--terra);line-height:1}
  .facts .l{font-family:var(--mono);font-size:7.5pt;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:2mm}
  .thumbs{display:flex;gap:2.6mm;margin-top:11mm}
  .thumbs .t{width:13mm;height:16.5mm;border-radius:2mm;background:var(--sand);border:1px solid var(--line);position:relative}
  .thumbs .t::after{content:"";position:absolute;left:2.2mm;right:2.2mm;top:2.6mm;height:1.2mm;border-radius:1mm;background:#cdbfa8}
  .thumbs .t::before{content:"";position:absolute;left:2.2mm;right:5.4mm;bottom:2.6mm;height:1.2mm;border-radius:1mm;background:#cdbfa8}
  .thumbs .t.on{background:var(--terra);border-color:var(--terra-deep)}
  .thumbs .t.on::after,.thumbs .t.on::before{background:rgba(255,255,255,.55)}

  /* ---------- data cards ---------- */
  .datarow{display:grid;grid-template-columns:1fr 1fr 1fr;gap:3.5mm;margin:5mm 0}
  .dc{background:#fff;border:1px solid var(--sand);border-radius:3mm;padding:4.5mm}
  .dc .n{font-family:var(--serif);font-weight:700;font-size:15pt;color:var(--terra);line-height:1}
  .dc .l{font-size:9pt;color:var(--muted);margin-top:2mm;line-height:1.35}

  /* ---------- pull quote ---------- */
  .pull{background:var(--dark);border-radius:3.5mm;padding:7mm 8mm;margin:6mm 0;box-shadow:0 4mm 10mm rgba(0,0,0,.14)}
  .pull p{font-family:var(--serif);font-size:14pt;line-height:1.3;color:#f1e7dd;margin:0}
  .pull em{font-style:italic;color:var(--terra)}
  .pull .src{font-family:var(--mono);font-size:8pt;letter-spacing:.1em;text-transform:uppercase;color:#8a7d70;margin-top:4mm;display:block}

  /* ---------- timeline ---------- */
  .tl2{margin-top:4mm}
  .tlrow{display:flex;gap:4.5mm;align-items:flex-start;padding-bottom:5mm;position:relative}
  .tlrow::before{content:"";position:absolute;left:5.5mm;top:12mm;bottom:0;width:1px;background:var(--line)}
  .tlrow:last-child::before{display:none}
  .tlt{width:11mm;height:11mm;border-radius:50%;background:var(--terra);color:#fff;flex:none;display:flex;
    align-items:center;justify-content:center;font-family:var(--mono);font-size:8pt;font-weight:700;z-index:1}
  .tlrow.alt .tlt{background:#fff;border:1.5px solid var(--terra);color:var(--terra)}
  .tlb b{font-size:11pt}
  .tlb p{margin:1mm 0 0;font-size:10pt}
  .tlb .who{font-family:var(--mono);font-size:8pt;letter-spacing:.08em;text-transform:uppercase;color:var(--terra);margin-top:1.5mm;display:block}

  /* ---------- crew ---------- */
  .crew{display:grid;grid-template-columns:1fr 1fr 1fr;gap:3.5mm;margin-top:2mm}
  .cw{border:1px solid var(--sand);border-radius:3mm;padding:4mm;background:#faf7f0;text-align:center}
  .cw svg{width:8mm;height:8mm;stroke:var(--terra);stroke-width:1.5;fill:none;stroke-linecap:round;stroke-linejoin:round;margin-bottom:2mm}
  .cw b{display:block;font-size:10pt}
  .cw span{font-size:8.5pt;color:var(--muted);line-height:1.3;display:block;margin-top:1mm}

  /* ---------- deliverables ---------- */
  .delgrid{display:grid;grid-template-columns:1fr 1fr;gap:3.5mm;margin-top:4mm}
  .del{background:#fff;border:1px solid var(--sand);border-radius:3mm;padding:4.5mm;position:relative}
  .del .fmt{font-family:var(--mono);font-size:7.5pt;letter-spacing:.1em;text-transform:uppercase;color:var(--terra);font-weight:700}
  .del > b{display:block;font-size:11pt;margin-top:1.5mm;font-family:var(--serif);font-weight:600}
  .del p b{color:var(--ink);font-weight:700}
  .del p{font-size:9.5pt;margin:1.5mm 0 0;line-height:1.45}

  /* ---------- planes ---------- */
  .plans{display:grid;grid-template-columns:1fr 1.12fr 1fr;gap:3mm;margin-top:5mm;align-items:start}
  .pl{border:1px solid var(--sand);border-radius:3.5mm;background:#fff;padding:5mm 4.5mm;position:relative}
  .pl.best{background:var(--dark);border-color:var(--dark);box-shadow:0 4mm 12mm rgba(0,0,0,.18);padding:7mm 5mm}
  .pl .nm{font-family:var(--mono);font-size:8.5pt;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--muted)}
  .pl.best .nm{color:var(--terra)}
  .pl .pr{font-family:var(--serif);font-weight:700;font-size:22pt;line-height:1;margin:3mm 0 1mm}
  .pl.best .pr{color:#fff;font-size:26pt}
  .pl .igv{font-size:8pt;color:var(--muted);margin-bottom:4mm}
  .pl.best .igv{color:#9d9086}
  .pl ul{list-style:none;margin-top:3mm}
  .pl li{font-size:9pt;line-height:1.4;padding:1.8mm 0 1.8mm 5mm;position:relative;border-top:1px solid #f0ebe0;color:#3a332c}
  .pl.best li{border-top:1px solid #2a251f;color:#ddd2c8}
  .pl li::before{content:"";position:absolute;left:0;top:3.4mm;width:2.2mm;height:2.2mm;border-radius:50%;background:var(--terra)}
  .pl li.off{color:#b3a89c}.pl li.off::before{background:#ddd2c1}
  .pl.best li.hi{color:#fff;font-weight:600}
  .tagbest{position:absolute;top:-3mm;left:5mm;background:var(--terra);color:#fff;font-family:var(--mono);
    font-size:7.5pt;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:1.6mm 3.5mm;border-radius:99px}

  /* ---------- protocolo ---------- */
  .prot{display:grid;grid-template-columns:1fr 1fr;gap:3mm;margin-top:4mm}
  .prow{display:flex;gap:3mm;align-items:flex-start;background:#fff;border:1px solid var(--sand);border-radius:2.5mm;padding:3.5mm}
  .prow .ck{width:5mm;height:5mm;border-radius:50%;background:#e9f3ec;color:#3C8C52;display:flex;align-items:center;
    justify-content:center;font-size:8pt;font-weight:700;flex:none;margin-top:.4mm}
  .prow b{font-size:9.5pt;display:block}
  .prow span{font-size:8.5pt;color:var(--muted);line-height:1.35;display:block;margin-top:.6mm}

  .cta{background:var(--blush);border-radius:3.5mm;padding:7mm;margin-top:6mm;display:flex;gap:6mm;align-items:center}
  .cta img{width:26mm;height:26mm;flex:none;object-fit:contain}
  .cta h3{font-size:15pt;margin-bottom:2mm}
  .cta h3 em{font-style:italic;color:var(--terra-deep)}
  .cta p{font-size:9.5pt;margin:0;color:#5a4a3e}
  .pill{display:inline-block;background:var(--terra);color:#fff;font-weight:700;font-size:10.5pt;
    padding:3mm 7mm;border-radius:999px;margin-top:3.5mm;font-family:var(--sans)}
  .vig{font-family:var(--mono);font-size:8pt;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-top:5mm;text-align:center}
</style>
</head>
<body>

<!-- ══════════ PAGE 1 — PORTADA ══════════ -->
<div class="page cover">
  <span class="badge">Propuesta audiovisual · para CAPERA Inmobiliaria</span>
  <h1>Un lote se entrega<br><em>una sola vez</em>.</h1>
  <div class="sub">Cobertura de la Entrega de Lotes — Etapa I<br>Loma Alta Condominio Club.</div>
  <p style="margin-top:9mm;max-width:135mm;color:var(--muted)">
    Fotografía, video y drone el día que 181 familias dejan de comprar una promesa
    y reciben un terreno con su nombre.
  </p>

  <div class="facts">
    <div><div class="n">26 SET</div><div class="l">2026 · Los Ejidos, Piura</div></div>
    <div><div class="n">3 h</div><div class="l">de cobertura continua</div></div>
    <div><div class="n">3</div><div class="l">cámaras · 3 profesionales</div></div>
  </div>

  <div class="thumbs">
    <span class="t on"></span><span class="t"></span><span class="t"></span><span class="t"></span>
    <span class="t"></span><span class="t"></span><span class="t"></span>
  </div>

  <div class="brand"><span>Jers | IA + Automatización</span><span>@soyjers</span></div>
</div>


<!-- ══════════ PAGE 2 — POR QUÉ ══════════ -->
<div class="page">
  <div class="kick">El contexto</div>
  <h2 style="margin-top:3mm">Loma Alta se vende con <em>confianza</em>.<br>La confianza no se argumenta: se muestra.</h2>

  <p class="lead">
    Un lote en Los Ejidos es una decisión de seis cifras que se firma <b>sin banco de por medio</b>.
    Eso significa que el comprador no está evaluando una tasa: está evaluando a CAPERA.
    Y a quien más le cree no es a la caseta de ventas — le cree al vecino que ya compró.
  </p>

  <div class="datarow">
    <div class="dc"><div class="n">181</div><div class="l">lotes en el proyecto, de 140 a 390 m²</div></div>
    <div class="dc"><div class="n">+7,000</div><div class="l">m² de áreas verdes y Club House</div></div>
    <div class="dc"><div class="n">Etapa I</div><div class="l">se entrega el 26 de setiembre</div></div>
  </div>

  <p>
    El 26 de setiembre pasa algo que no se puede recrear después: la cara de una familia
    recibiendo su lote. Esa toma no se actúa, no se repite y no se compra en un banco de imágenes.
    <b>Existe tres horas y luego desaparece.</b>
  </p>

  <div class="pull">
    <p>Lo que se graba ese día no es un evento.<br>
    Es el <em>catálogo de prueba social</em> con el que se venden los lotes que quedan.</p>
    <span class="src">Ese es el criterio de toda esta propuesta</span>
  </div>

  <p>
    Por eso la pieza central no es el video bonito del evento: son los <b>testimonios de clientes reales</b>,
    grabados en el momento exacto en que están más convencidos de su decisión. Un comprador diciendo
    a cámara por qué eligió Loma Alta vale más que cualquier render — y solo se puede capturar ese día.
  </p>

  <div class="brand"><span>Jers | IA + Automatización</span><span>Entrega Etapa I · Loma Alta</span></div>
</div>


<!-- ══════════ PAGE 3 — EL OPERATIVO ══════════ -->
<div class="page">
  <div class="kick">El operativo</div>
  <h2 style="margin-top:3mm">Tres horas, tres cámaras,<br>ningún momento <em>improvisado</em>.</h2>

  <p>Un equipo de tres personas no es lujo: es la única forma de cubrir ceremonia, aéreas y
    entrevistas al mismo tiempo sin sacrificar ninguna.</p>

  <div class="crew">
    <div class="cw">
      <svg viewBox="0 0 24 24"><path d="M3 8h3l2-2h8l2 2h3v11H3z"/><circle cx="12" cy="13" r="3.4"/></svg>
      <b>Fotógrafo</b><span>Ceremonia, familias, detalles y protocolo</span>
    </div>
    <div class="cw">
      <svg viewBox="0 0 24 24"><rect x="3" y="7" width="12" height="10" rx="2"/><path d="M15 11l6-3v8l-6-3z"/></svg>
      <b>Videógrafo</b><span>Video principal, ambiente y testimonios</span>
    </div>
    <div class="cw">
      <svg viewBox="0 0 24 24"><path d="M5 5l4 4M19 5l-4 4M5 19l4-4M19 19l-4-4"/><rect x="9" y="9" width="6" height="6" rx="1.5"/><circle cx="5" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/></svg>
      <b>Piloto de drone</b><span>Aéreas del proyecto y segunda cámara</span>
    </div>
  </div>

  <div class="kick" style="margin-top:8mm">Plan de rodaje</div>
  <div class="tl2">
    <div class="tlrow">
      <div class="tlt">0:00</div>
      <div class="tlb"><b>Llegada y aéreas de apertura</b>
        <p>Vuelo sobre la Etapa I y el Club House mientras llegan los invitados. Luz y viento son mejores al inicio.</p>
        <span class="who">Drone + fotógrafo</span></div>
    </div>
    <div class="tlrow alt">
      <div class="tlt">0:40</div>
      <div class="tlb"><b>Ceremonia y entrega</b>
        <p>Palabras de la gerencia, entrega de documentos y el momento familia–lote. Cobertura simultánea foto + video.</p>
        <span class="who">Los 3 en posición</span></div>
    </div>
    <div class="tlrow">
      <div class="tlt">1:30</div>
      <div class="tlb"><b>Rincón de testimonios</b>
        <p>Punto fijo montado aparte, con luz e inalámbrico de solapa. Los compradores pasan de a uno mientras el evento sigue.
           Sin esto, los testimonios salen con ruido de fondo y no sirven para pauta.</p>
        <span class="who">Videógrafo + piloto en 2.ª cámara</span></div>
    </div>
    <div class="tlrow alt">
      <div class="tlt">2:30</div>
      <div class="tlb"><b>Recorrido y cierre</b>
        <p>Recorrido por lotes y amenities, retratos de la gerencia, planos de detalle y últimas aéreas con luz cálida.</p>
        <span class="who">Los 3</span></div>
    </div>
  </div>

  <div class="pull" style="margin-top:2mm">
    <p>De todo lo que se graba ese día, el testimonio es lo <em>único</em> que no se puede repetir después.<br>
       Por eso tiene su propio bloque en el plan, y no se deja para el final.</p>
  </div>

  <div class="brand"><span>Jers | IA + Automatización</span><span>Entrega Etapa I · Loma Alta</span></div>
</div>


<!-- ══════════ PAGE 4 — ENTREGABLES ══════════ -->
<div class="page">
  <div class="kick">Lo que reciben</div>
  <h2 style="margin-top:3mm">Un evento, <em>cinco</em> piezas<br>que trabajan por separado.</h2>

  <p>Cada formato tiene un trabajo distinto: uno cierra ventas en reunión, otro corre en Instagram,
     otro se pone en pauta pagada. Se entregan listos para publicar, sin marca de agua.</p>

  <div class="delgrid">
    <div class="del">
      <div class="fmt">Fotografía</div>
      <b>Galería del evento</b>
      <p>Fotos editadas y con color corregido: ceremonia, familias, autoridades, amenities y detalles.
         Entrega en galería web descargable, alta y baja resolución.</p>
    </div>
    <div class="del">
      <div class="fmt">Video 16:9 · con animación</div>
      <b>Resumen institucional</b>
      <p>El video que se muestra en reunión, en la caseta de ventas y en la web. Con titulares animados,
         logo de Loma Alta y datos del proyecto en pantalla. Musicalizado con licencia.</p>
    </div>
    <div class="del">
      <div class="fmt">Video 9:16 · vertical</div>
      <b>Reel del evento</b>
      <p>Versión corta y rápida para Instagram, TikTok y Facebook, con el ritmo que pide el feed
         y textos legibles sin sonido.</p>
    </div>
    <div class="del">
      <div class="fmt">Video 16:9 + 9:16</div>
      <b>Testimonios de clientes</b>
      <p>Compradores reales contando por qué eligieron Loma Alta. Cada testimonio se entrega en
         <b>las dos versiones</b>: horizontal para web y presentaciones, vertical para redes y pauta.</p>
    </div>
  </div>

  <div class="del" style="margin-top:3.5mm">
    <div class="fmt">Bonus operativo</div>
    <b>Teaser en 48 horas</b>
    <p>Un adelanto corto entregado dos días después del evento, mientras la noticia todavía está caliente y
       los asistentes siguen comentando. El material completo llega después; la conversación no espera.</p>
  </div>

  <div class="pull" style="margin-top:6mm">
    <p>Todo el material queda <em>en poder de CAPERA</em>:<br>
       redes, web, caseta de ventas y publicidad pagada.</p>
  </div>

  <div class="brand"><span>Jers | IA + Automatización</span><span>Entrega Etapa I · Loma Alta</span></div>
</div>


<!-- ══════════ PAGE 5 — PLANES ══════════ -->
<div class="page">
  <div class="kick">Inversión</div>
  <h2 style="margin-top:3mm">Tres formas de cubrir<br>el <em>26 de setiembre</em>.</h2>

  <div class="plans">
    <div class="pl">
      <div class="nm">Esencial</div>
      <div class="pr">S/ 3,900</div>
      <div class="igv">+ IGV · 2 personas</div>
      <ul>
        <li>3 h de cobertura</li>
        <li>60 fotos editadas</li>
        <li>Drone: 20 min de aéreas</li>
        <li>Resumen 16:9 de 90 s <span style="color:#b3a89c">(sin animación)</span></li>
        <li>1 reel vertical 45 s</li>
        <li class="off">Sin testimonios</li>
        <li class="off">Sin teaser previo</li>
        <li>Entrega: 12 días hábiles</li>
      </ul>
    </div>

    <div class="pl best">
      <span class="tagbest">Recomendado</span>
      <div class="nm">Institucional</div>
      <div class="pr">S/ 5,900</div>
      <div class="igv">+ IGV · 3 personas · 3 cámaras</div>
      <ul>
        <li class="hi">3 h · fotógrafo + videógrafo + piloto de drone</li>
        <li class="hi">80 fotos editadas + galería completa</li>
        <li>Drone: cobertura aérea completa</li>
        <li class="hi">Resumen 16:9 de 2–3 min <b>con animación</b></li>
        <li>Reel vertical 45–60 s</li>
        <li class="hi">3 testimonios en 16:9 <b>y</b> 9:16 (6 piezas)</li>
        <li>Rincón de testimonios con luz y micrófono</li>
        <li>Teaser en 48 h</li>
        <li>Derechos de uso comercial · 12 meses</li>
        <li class="hi">Entrega: 7 días hábiles</li>
      </ul>
    </div>

    <div class="pl">
      <div class="nm">Insignia</div>
      <div class="pr">S/ 8,500</div>
      <div class="igv">+ IGV · 3 personas · 4 h</div>
      <ul>
        <li>Todo lo del plan Institucional, y además:</li>
        <li>1 hora extra de cobertura</li>
        <li>100 fotos + 10 verticales para historias</li>
        <li><b>5 testimonios</b> en ambos formatos (10 piezas)</li>
        <li>2.º reel: recorrido aéreo del proyecto</li>
        <li>Versión subtitulada y versión sin música para pauta</li>
        <li>Derechos de uso comercial · 24 meses</li>
        <li>Entrega: 7 días hábiles</li>
      </ul>
    </div>
  </div>

  <div class="pull" style="margin-top:7mm">
    <p>Un lote de Loma Alta supera las <em>seis cifras</em>.<br>
       El plan Institucional cuesta menos del <em>5%</em> de un solo lote.</p>
    <span class="src">Un lote vendido con este material paga la producción veinte veces</span>
  </div>

