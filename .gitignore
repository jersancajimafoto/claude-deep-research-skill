# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
ENV/
env/

# Secrets / API keys (NUNCA versionar)
.env
*.env
!*.env.example
prospeccion-ia/.env
# Llaves privadas y certificados (nunca hay caso legítimo para versionarlos)
*.pem
*.key
*.p12
*.pfx
# Bases de datos locales (pueden contener PII)
*.sqlite
*.sqlite3
*.db
# Config local de Claude Code (puede contener rutas/tokens propios)
.claude/settings.local.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Research output (kept local). Nota: salida/*.json (con PII de leads) queda local.
*.json
!schemas/*.json
# Manifiestos de Node SÍ se versionan (reproducibilidad), pese a *.json
!package.json
!package-lock.json
!**/package.json
!**/package-lock.json
# TypeScript config para proyectos Node (ej. tienda-jers/)
!tsconfig.json
# Product JSON content files (tienda-jers store products)
!tienda-jers/content/**/*.json

# Node
node_modules/
prospeccion-ia/uploads/

# PII de leads: TODA salida del pipeline de prospección queda local,
# sea cual sea el formato (.json ya cubierto arriba; esto cubre .md/.csv/etc.)
prospeccion-ia/salida/
prospeccion-ia/**/*.csv
prospeccion-ia/**/*.xlsx

# Test output
.pytest_cache/
.coverage
htmlcov/

# Cloned external skills/repos (kept local)
andrej-karpathy-skills/

# graphify knowledge graph output
graphify-out/

# youtube-shorts: media generada y temporales (no versionar binarios pesados).
# Globs acotados al subproyecto: reglas repo-wide (*.mp4) ya tragaron archivos
# en silencio antes (caso *.json / tienda-jers/tsconfig.json).
youtube-shorts/tmp/
youtube-shorts/salida/
youtube-shorts/assets/
youtube-shorts/**/*.mp4
youtube-shorts/**/*.mp3
youtube-shorts/**/*.wav

# Oro Azul — imágenes crudas de Firefly (pesadas, no versionar; sí van los recortes usados)
marcas/oro-azul/piezas/hero-patrias-raw.png
marcas/oro-azul/piezas/hero-patrias-v2.png
marcas/oro-azul/piezas/*.DS_Store

# Fotografías de clientes (Jers Ancajima) — derecho de imagen, no se versionan
marcas/jers-ancajima/fotos/*
!marcas/jers-ancajima/fotos/LEEME.md
marcas/jers-ancajima/guia/fotos/
marcas/jers-ancajima/render/

# Candidatas de curaduría (fotos de clientes) — no versionar
marcas/jers-ancajima/candidatas/

# Álbumes por pareja (fotos de clientes) — no versionar
marcas/jers-ancajima/albumes/
marcas/jers-ancajima/contenido/carruseles/

# DNA de marca (JSON de diseño, no secretos)
!marcas/**/design-dna.json
